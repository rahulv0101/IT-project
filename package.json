{
  "name": "eduquest",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "seed": "node backend/scripts/seed.js",
    "seed:reset": "node backend/scripts/seed-reset.js",
    "setup:token": "node scripts/setup-token.mjs",
    "dev": "npm run setup:token && concurrently \"node backend/src/index.js\" \"python ai-service/run.py\" \"node backend/scripts/ai-worker.js\" \"node backend/scripts/session-reminders.js\" \"vite --config frontend/vite.config.js\"",
    "build": "npm --prefix frontend run build",
    "db:migrate": "node backend/scripts/migrate.js",
    "db:test:reset": "node backend/scripts/reset-test-db.js",
    "db:setup-check": "node scripts/db-setup-check.mjs",
    "db:start": "node scripts/pglite-server.mjs start",
    "db:stop": "node scripts/pglite-server.mjs stop",
    "db:status": "node scripts/pglite-server.mjs status",
    "ai:worker": "node backend/scripts/ai-worker.js",
    "test:db:real": "node scripts/test-real-db.mjs",
    "test:ai:real": "node scripts/test-ai-real.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "db:seed": "node backend/scripts/seed.js",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "backup:pg": "node scripts/backup-pg.mjs",
    "restore:pg": "node scripts/restore-pg.mjs",
    "test:backup": "node scripts/run-backup-test.mjs",
    "test:seed": "node scripts/test-seed-idempotence.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.3.1",
    "obscenity": "^0.4.6",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
