NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/eduquest?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/eduquest_test?sslmode=disable
PGLITE_DEV_PORT=5432
PGLITE_TEST_PORT=5433
COOKIE_SECURE=false
UPLOAD_MAX_BYTES=20971520
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=generate-a-long-random-token
MFA_ENCRYPTION_KEY=generate-a-64-character-hex-key-with-npm-run-setup-token
AI_MAX_BODY_BYTES=2097152
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-haiku-5.5
AI_API_KEY=
AI_MODEL_FALLBACKS=
AI_BATCH_SIZE=5
AI_MAX_TOKENS=6000
AI_MAX_REQUESTS_PER_RUN=20
AI_REQUEST_DELAY_MS=0
AI_TIMEOUT_SECONDS=120
AI_REQUEST_TIMEOUT_SECONDS=150
AI_WORKER_TIMEOUT_MS=180000
AI_MAX_SOURCE_CHARS=60000
SEED_LECTURER_EMAIL=lecturer@example.com
SEED_LECTURER_NAME=Demo Lecturer
# Supply a precomputed argon2id/bcrypt hash; never put a plaintext password here.
SEED_LECTURER_PASSWORD_HASH=
